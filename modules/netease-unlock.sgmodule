#!name=NetEase Music Unlock
#!desc=Unlock region-locked (grayed-out) songs via your own unlock endpoint. MITM required — see modules/README.md.
#!category=Music
#!author=us-kg

# ======================================================================
# Unlocking needs a backend that substitutes an alternative audio source
# for region-locked songs. This module provides the wiring (MITM +
# request hooks); you bring the unlock endpoint. Two paths:
#
# Path A (recommended): self-host UnblockNeteaseMusic
#   https://github.com/UnblockNeteaseMusic/server
# on your own VPS, then uncomment the rewrite below and set YOUR_SERVER.
#
# Path B: use a community unlock script you trust. Paste its URL into
# the [Script] entry below. Note: these break whenever NetEase changes
# their API — check the script's repo for updates.
# ======================================================================

[MITM]
hostname = %APPEND% music.163.com, *.music.163.com, interface.music.163.com, interface3.music.163.com

[URL Rewrite]
# Path A: redirect playback-URL API calls to your unlock server.
# ^https?://music\.163\.com/api/song/enhance/player/url(.*) http://YOUR_SERVER:8080/api/song/enhance/player/url$1 302

[Script]
# Path B: hook the playback-URL API response with a community script.
# NetEase Unlock = type=http-response,pattern=^https?://music\.163\.com/api/song/enhance/player/url,script-path=YOUR_SCRIPT_URL,requires-body=true,timeout=15
